{
  "name": "musiccontext",
  "version": "0.1.0",
  "description": "Music direction for AI agents: turn a video into a structured Music Direction Plan (story -> direction -> candidate selection -> sync), search a local library, generate music offline, and render the mixed video with FFmpeg.",
  "author": {
    "name": "MusicContext contributors",
    "url": "https://github.com/AAGAM17/MusicContext"
  },
  "homepage": "https://github.com/AAGAM17/MusicContext",
  "repository": "https://github.com/AAGAM17/MusicContext",
  "license": "Apache-2.0",
  "keywords": [
    "music",
    "video",
    "soundtrack",
    "music-direction",
    "ffmpeg",
    "agent-skills",
    "mcp"
  ],
  "skills": [
    "./skills"
  ],
  "mcpServers": {
    "musiccontext": {
      "type": "stdio",
      "command": "musiccontext",
      "args": [
        "mcp"
      ]
    }
  }
}
